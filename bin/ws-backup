#! /usr/bin/zsh
# Back up ~/ws to the restic repository on the HDD (/mnt/hdd/restic, shared
# with data-backup), without build output, caches or 3p clones (only their
# list: see 3p). Run every 15 minutes by a systemd user timer
# (home/backup.nix); fine to run by hand. Does nothing when the HDD isn't
# mounted. To leave a folder out, put a CACHEDIR.TAG file in it.
#
# Restore a file or folder from the latest snapshot:
#   restic -r /mnt/hdd/restic --password-file ~/.config/restic/hdd \
#       restore latest --tag ws --include ~/ws/<path> --target /tmp/restore
# or browse every snapshot: ... mount ~/mnt
setopt err_exit pipe_fail

WS=${WS_BACKUP_SRC:-$HOME/ws} # the variables are for testing
DRIVE=${WS_BACKUP_DRIVE:-/mnt/hdd}
export RESTIC_REPOSITORY=$DRIVE/restic
export RESTIC_PASSWORD_FILE=${RESTIC_PASSWORD_FILE:-$HOME/.config/restic/hdd}

# Mounted, not just the automount point (listing it triggers the automount)
if ! timeout 20 ls $DRIVE > /dev/null 2>&1 ||
    ! findmnt -rn -o FSTYPE --mountpoint $DRIVE | grep -qvx autofs; then
    print "$DRIVE is not mounted: skipping."
    exit 0
fi

# Refresh the list of 3p clones at most daily (it checks every clone)
manifest=($WS/3p/.manifest/manifest.tsv(N.mh-24))
if [[ -d $WS/3p && -z $manifest ]]; then
    ${0:A:h}/3p save > /dev/null || print '3p save failed: backing up the old list.'
fi

# Build output by name; caches that carry CACHEDIR.TAG, virtualenvs (have a
# pyvenv.cfg); cargo's target/ by place (next to a Cargo.toml: cargo tags only
# the target dirs it created itself)
excludes=$(mktemp)
trap 'rm -f $excludes' EXIT
{
    print -r -- "$WS/3p/*"
    print -r -- "!$WS/3p/.manifest"
    print -l -- node_modules __pycache__ .mypy_cache .ruff_cache .pytest_cache \
        .direnv .svelte-kit .next .turbo .pnpm-store
    find $WS -path $WS/3p -prune -o -name node_modules -prune -o \
        -type d -name target -execdir test -f Cargo.toml \; -print -prune 2> /dev/null
    # Unreal projects (next to a .uproject): what the editor and builds
    # regenerate, in the project and its plugins
    find $WS -path $WS/3p -prune -o -name node_modules -prune -o \
        -type f -name '*.uproject' -printf '%h\n' 2> /dev/null |
        sort -u | while read -r project; do
            for sub in Binaries Intermediate Saved DerivedDataCache; do
                print -r -- "$project/$sub"
                print -r -- "$project/Plugins/**/$sub"
            done
        done
} > $excludes

# The nightly prune (data-backup) locks the repository: wait for it
rc=0
restic backup --tag ws --retry-lock 2h --exclude-caches \
    --exclude-if-present pyvenv.cfg --exclude-file $excludes $WS || rc=$?
(( rc == 0 || rc == 3 )) || exit $rc # 3: some files couldn't be read (named above)

# Thin out old snapshots; data-backup's nightly prune frees their space. Skipped
# when another run holds the lock (the next one does it).
restic forget --tag ws --retry-lock 5m --keep-last 8 --keep-hourly 48 \
    --keep-daily 14 --keep-weekly 8 --keep-monthly 24 > /dev/null ||
    print 'forget skipped: the repository is busy.'
print "Backed up $WS."
