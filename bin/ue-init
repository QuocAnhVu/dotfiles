#! /usr/bin/zsh
# Make an Unreal project its own git repo, with Git LFS for the binary assets
# (.uasset, .umap, meshes, textures, audio) and the folders the editor
# regenerates ignored. Safe to rerun: existing .gitignore/.gitattributes are
# kept, and an existing repo is reused.
#
# Usage:
#   ue-init [DIR]   the project directory (default: the current one)
#
# ws-backup skips the regenerated folders of any directory with a .uproject.
setopt err_exit pipe_fail

function message() { print -P "%F{yellow}ue-init:%f $*" }

dir=${1:-.}
cd $dir
uprojects=(*.uproject(N))
if [[ -z $uprojects ]]; then
    message "no .uproject in ${dir:a}: run it in the project directory."
    exit 1
fi

# A project inside another repo: that repo must ignore it, or it would add
# the assets (and see this repo as an embedded one)
parent=$(git -C .. rev-parse --show-toplevel 2> /dev/null || true)

[[ -d .git ]] || git init --quiet
git lfs install --local > /dev/null

if [[ ! -e .gitignore ]]; then
    cat > .gitignore <<'EOF'
# Regenerated by the editor and builds (also in plugins)
Binaries/
Intermediate/
Saved/
DerivedDataCache/

# IDE and project files, generated by the editor
.vs/
.vscode/
.idea/
*.sln
*.code-workspace
compile_commands.json
EOF
fi

if [[ ! -e .gitattributes ]]; then
    {
        print '# Binary assets go to Git LFS'
        for ext in uasset umap \
            fbx obj abc glb blend usd usdc usdz vrm \
            png jpg jpeg tga psd exr hdr tif tiff dds \
            wav mp3 ogg flac \
            mp4 mov webm \
            ttf otf; do
            print "*.$ext filter=lfs diff=lfs merge=lfs -text"
        done
    } > .gitattributes
fi

message "${PWD} is a git repo with LFS (${uprojects[1]:r})."
if [[ -n $parent ]]; then
    message "it is inside ${parent}: add '${PWD#$parent/}/' to that repo's .gitignore."
fi
